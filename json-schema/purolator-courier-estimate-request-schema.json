          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Number of Return Shipments to generate for current Shipment. Min Value is 1 and Max value is 100. Mandatory if Shipment Type is Return"
        },
        "billingInformation": {
          "$ref": "#/$defs/BillingInformation"
        },
        "senderInformation": {
          "$ref": "#/$defs/SenderAddress"
        },
        "receiverInformation": {
          "$ref": "#/$defs/ReceiverAddress"
        },
        "shipmentInformation": {
          "$ref": "#/$defs/ReturnCourierPackageInformation"
        }
      }
    },
    "SenderAddress": {
      "type": "object",
      "required": [
        "city",
        "provinceStateCode",
        "country",
        "postalZipCode"
      ],
      "properties": {
        "companyName": {
          "type": "string",
          "maximum": 30,
          "description": "Company Name information."
        },
        "streetAddress": {
          "type": "array",
          "maximum": 3,
          "minimum": 1,
          "items": {
            "$ref": "#/$defs/AddressLine"
          },
          "description": "Maximum 3 addresses allowed. Each address has a max length of 40 characters"
        },
        "city": {
          "type": "string",
          "maximum": 40,
          "description": "City"
        },
        "provinceStateCode": {
          "type": "string",
          "maximum": 40,
          "enum": [
            "AB",
            "BC",
            "MB",
            "NB",
            "NL",
            "NS",
            "NT",
            "NU",
            true,
            "PE",
            "QC",
            "SK",
            "YT"
          ],
          "description": "2 character code for the Province/State, required for Canadian and US addresses. Note that currently only Canadian addresses are accepted for the sender. Valid Province Codes for Canada: AB, BC, MB, NB, NL, NS, NT, NU, ON, PE, QC, SK, YT."
        },
        "country": {
          "type": "string",
          "maximum": 2,
          "enum": [
            "CA"
          ],
          "description": "2-character CountryCode. Note that currently only Canadian addresses are accepted for the sender."
        },
        "postalZipCode": {
          "type": "string",
          "maximum": 10,
          "description": "Canadian Postal Code or USA Zip Code or Intl Postal Code. Note that currently only Canadian addresses are accepted for the sender."
        }
      }
    },
    "ShipmentDate": {
      "type": "string",
      "format": "date",
      "default": "Today's Date",
      "description": "Date of shipment. Up to 10 days in advance. Date format: YYYY-MM-DD. If not present, default to today's date."
    },
    "TrackingReference": {
      "type": "string",
      "maximum": 35,
      "description": "Tracking reference information"
    },
    "TrackingReferenceInformation": {
      "type": "object",
      "properties": {
        "reference1": {
          "$ref": "#/$defs/TrackingReference"
        },
        "reference2": {
          "$ref": "#/$defs/TrackingReference"
        },
        "reference3": {
          "$ref": "#/$defs/TrackingReference"
        },
        "reference4": {
          "$ref": "#/$defs/TrackingReference"
        },
        "reference5": {
          "$ref": "#/$defs/TrackingReference"
        }
      }
    },
    "USOriginInformation": {
      "type": "object",
      "description": "US origin address information. Required when the shipment originates from the United States. Only US country code is accepted.",
      "required": [
        "city",
        "provinceStateCode",
        "country",
        "postalZipCode"
      ],
      "properties": {
        "companyName": {
          "type": "string",
          "maximum": 30,
          "description": "Company Name information."
        },
        "streetAddress": {
          "type": "array",
          "maximum": 3,
          "minimum": 1,
          "items": {
            "$ref": "#/$defs/AddressLine"
          },
          "description": "Maximum 3 addresses allowed. Each address has a max length of 40 characters."
        },
        "city": {
          "type": "string",
          "maximum": 40,
          "description": "City"
        },
        "provinceStateCode": {
          "type": "string",
          "maximum": 40,
          "enum": [
            "AK",
            "AL",
            "AR",
            "AZ",
            "CA",
            "CO",
            "CT",
            "DC",
            "DE",
            "FL",
            "GA",
            "HI",
            "IA",
            "ID",
