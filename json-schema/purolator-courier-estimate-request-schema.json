          ],
          "description": "2 character code for the US State. Valid State Codes: AK, AL, AR, AZ, CA, CO, CT, DC, DE, FL, GA, HI, IA, ID, IL, IN, KS, KY, LA, MA, MD, ME, MI, MN, MO, MS, MT, NC, ND, NE, NH, NJ, NM, NV, NY, OH, OK, OR, PA, RI, SC, SD, TN, TX, UT, VA, VT, WA, WI, WV, WY."
        },
        "country": {
          "type": "string",
          "maximum": 2,
          "enum": [
            "US"
          ],
          "description": "2-character CountryCode. Only US is accepted for US origin information."
        },
